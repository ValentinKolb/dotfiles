# Managed by chezmoi.

font-family = "JetBrains Mono"
theme = "GitHub Dark High Contrast"

cursor-style = block
split-divider-color = #45484C
shell-integration-features = no-cursor,path

{{ if eq .chezmoi.os "darwin" -}}
quick-terminal-position = center
quick-terminal-screen = mouse
quick-terminal-autohide = true

keybind = cmd+shift+e=equalize_splits
keybind = cmd+shift+left=new_split:left
keybind = cmd+shift+right=new_split:right
keybind = cmd+shift+up=new_split:up
keybind = cmd+shift+down=new_split:down
keybind = cmd+left=goto_split:left
keybind = cmd+right=goto_split:right
keybind = cmd+up=goto_split:up
keybind = cmd+down=goto_split:down
{{ end -}}
